<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mccruz.tablademultiplicar.TablaMultiplicarController">
    <children>
        <Label text="Tabla del:" layoutX="20" layoutY="20"/>
        <TextField fx:id="numero" layoutX="20" layoutY="40"/>
        <Button text="Calcular" layoutX="200" layoutY="20" onAction="#calcularTabla"/>
        <Button text="Limpiar" layoutX="200" layoutY="50" onAction="#limpiarCampo"/>
        <TextArea fx:id="resultado" layoutX="20" layoutY="80" prefWidth="250" prefHeight="200"/>
    </children>
</AnchorPane>
